# =====================================================================
#  ORTAM DEĞİŞKENLERİ – ÖRNEK DOSYA
#  Bu dosyayı ".env" adıyla kopyalayın ve kendi değerlerinizi yazın.
#      Windows : copy .env.example .env
#      Linux   : cp .env.example .env
#
#  ".env" dosyası .gitignore içindedir; asla depoya gönderilmez.
# =====================================================================

# --- Uygulama --------------------------------------------------------
# APP_DEBUG BİLEREK KAPALI (yorumda) GELİYOR.
#
# Satır yokken uygulama kendi karar verir: yerelde (localhost, *.test,
# *.local) açık, gerçek bir alan adında kapalı olur. Bu, bu dosyayı
# olduğu gibi kopyalayıp canlıya çıkan birini korur — açık bir hata
# yığını dosya yollarınızı, tablo adlarınızı ve sorgularınızı sızdırır.
#
# Yerelde zaten açıktır; elle açmanız gerekmez. Yalnızca kararı
# ZORLAMAK istiyorsanız aşağıdaki satırı etkinleştirin.
# APP_DEBUG=true
APP_URL=
APP_PRETTY_URLS=true

# --- Veritabanı ------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cy_ai
DB_USER=root
DB_PASS=

# --- YAPAY ZEKÂ SAĞLAYICISI -----------------------------------------
#
#  !!! ANAHTAR YALNIZCA SUNUCUDA KALIR !!!
#  Tarayıcıya gönderilmez. JavaScript'e koyup doğrudan API'ye istek
#  atmak, anahtarınızı sayfayı açan herkese vermek demektir —
#  faturayı da onlar doldurur.
#
#  Hangi sağlayıcı kullanılacak?
#
#    gemini             ÜCRETSİZ KATMAN VAR  (varsayılan)
#                       Anahtar: aistudio.google.com/apikey
#                       Kredi kartı istemez, birkaç saniyede alınır.
#
#    groq               ÜCRETSİZ KATMAN VAR
#                       Anahtar: console.groq.com/keys
#                       OpenAI uyumlu; çok hızlı.
#
#    openai-compatible  "chat/completions" konuşan HER servis:
#                       xAI (Grok), OpenRouter, Ollama…
#                       AI_BASE_URL vermeniz gerekir.
#
#    claude             ÜCRETLİ — console.anthropic.com
#
AI_PROVIDER=gemini

#  Anahtar. Sağlayıcının kendi adını da kullanabilirsiniz
#  (GEMINI_API_KEY, GROQ_API_KEY, ANTHROPIC_API_KEY); AI_API_KEY
#  hepsinin yerine geçer, böylece sağlayıcı denerken tek satır
#  değiştirmeniz yeterli olur.
GEMINI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# AI_API_KEY=

#  Kullanılacak model. Boş bırakırsanız sağlayıcının varsayılanı
#  kullanılır (gemini → gemini-2.5-flash).
#
#  GEMINI — ücretsiz katmanda Flash ailesi kullanılabilir:
#    gemini-2.5-flash        dengeli, güvenli varsayılan
#    gemini-2.5-flash-lite   daha hızlı ve daha ucuz
#    gemini-3.5-flash        daha yetenekli
#    gemini-3.8-flash        en yeni
#  Hangi modelin ücretsiz katmanda olduğu değişebilir; güncel
#  listeyi ve kotanızı aistudio.google.com/rate-limit gösterir.
#
#  GROQ  → llama-3.3-70b-versatile   (console.groq.com/docs/models)
#  CLAUDE → claude-sonnet-5 · claude-opus-5 · claude-haiku-4-5
AI_MODEL=gemini-2.5-flash

#  Yalnızca AI_PROVIDER=openai-compatible için taban adres:
#    xAI (Grok)  https://api.x.ai/v1
#    OpenRouter  https://openrouter.ai/api/v1
#    Ollama      http://localhost:11434/v1
# AI_BASE_URL=

#  Yanıtın en fazla kaç jeton olacağı.
#  DÜŞÜK TUTMAYIN: sınıra çarpan yanıt cümlenin ortasında kesilir.
AI_MAX_TOKENS=4096

#  GEMINI: düşünme özeti yanıtta gelsin mi? Varsayılan kapalı —
#  bu alanı desteklemeyen bir modele göndermek 400 verir.
# AI_THINKING=false

#  CLAUDE: düşünme derinliği — low · medium · high · xhigh · max
#  Kaliteyi ve maliyeti birlikte belirler.
AI_EFFORT=medium
