# =====================================================================
#  ORTAM DEĞİŞKENLERİ – ÖRNEK DOSYA
#  Bu dosyayı ".env" adıyla kopyalayın ve kendi değerlerinizi yazın.
#      Windows : copy .env.example .env
#      Linux   : cp .env.example .env
#
#  ".env" dosyası .gitignore içindedir; asla depoya gönderilmez.
# =====================================================================

# --- Uygulama --------------------------------------------------------
# Bu satırı SİLERSENİZ uygulama kendi karar verir: yerelde (localhost,
# *.test, *.local) açık, gerçek bir alan adında kapalı. Canlı sunucuda
# hata detayı göstermek dosya yollarınızı ve tablo adlarınızı sızdırır.
APP_DEBUG=true
APP_URL=
APP_PRETTY_URLS=true

# --- Veritabanı ------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cy_ai
DB_USER=root
DB_PASS=

# --- ANTHROPIC (CLAUDE) API ------------------------------------------
#  Anahtarı console.anthropic.com adresinden alırsınız.
#
#  !!! ANAHTAR YALNIZCA SUNUCUDA KALIR !!!
#  Tarayıcıya gönderilmez. JavaScript'e koyup doğrudan API'ye istek
#  atmak, anahtarınızı sayfayı açan herkese vermek demektir —
#  faturayı da onlar doldurur.
ANTHROPIC_API_KEY=

#  Kullanılacak model.
#    claude-opus-5     en yetenekli    ($5 / $25 — 1M jeton, giriş/çıkış)
#    claude-sonnet-5   dengeli         ($2 / $10)
#    claude-haiku-4-5  hızlı ve ucuz   ($1 / $5)
#
#  Fiyatlar değişebilir; güncel liste: anthropic.com/pricing
AI_MODEL=claude-opus-5

#  Yanıtın en fazla kaç jeton olacağı.
#  DÜŞÜK TUTMAYIN: sınıra çarpan yanıt cümlenin ortasında kesilir.
AI_MAX_TOKENS=16000

#  Düşünme derinliği: low · medium · high · xhigh · max
#  Kaliteyi ve maliyeti birlikte belirler. Sohbet gibi hafif işlerde
#  "low" çoğu zaman yeterlidir ve belirgin biçimde ucuzdur; zor akıl
#  yürütme gerektiren işlerde yükseltin.
AI_EFFORT=medium
